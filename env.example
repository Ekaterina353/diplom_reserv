# ========================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ДЛЯ DJANGO ПРИЛОЖЕНИЯ
# ========================================

# ========================================
# 🔐 БЕЗОПАСНОСТЬ
# ========================================

# Секретный ключ Django (обязательно!)
# Генерируйте новый ключ: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-your-secret-key-here

# Режим отладки (True для разработки, False для продакшена)
DEBUG=True

# Разрешенные хосты (через запятую)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ========================================
# 🗄️ БАЗА ДАННЫХ
# ========================================

# Название базы данных
DB_NAME=restaur_reserve

# Пользователь базы данных
DB_USER=postgres

# Пароль базы данных
DB_PASSWORD=your-database-password

# Хост базы данных
DB_HOST=localhost

# Порт базы данных
DB_PORT=5432

# ========================================
# 🤖 TELEGRAM BOT
# ========================================

# Токен Telegram бота
# Получите у @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=7872717484:AAEkeg9mR0tUL5qYKTSNc4uymWtdhfpvZQM

# Chat ID для уведомлений
# Получите командой: python manage.py get_telegram_chat_id
TELEGRAM_CHAT_ID=311492733

# ========================================
# 🐳 DOCKER (опционально)
# ========================================

# Имя пользователя Docker Hub
DOCKER_USERNAME=your-docker-username

# Токен Docker Hub
DOCKER_PASSWORD=your-docker-token

# ========================================
# 🔒 БЕЗОПАСНОСТЬ (опционально)
# ========================================

# Токен Snyk для сканирования безопасности
SNYK_TOKEN=your-snyk-token

# ========================================
# 🚀 ДЕПЛОЙ (опционально)
# ========================================

# Хост для деплоя
DEPLOY_HOST=your-server-ip

# Пользователь для деплоя
DEPLOY_USER=deploy

# SSH приватный ключ для деплоя
DEPLOY_KEY=-----BEGIN OPENSSH PRIVATE KEY-----
your-private-key-content
-----END OPENSSH PRIVATE KEY-----

# ========================================
# 📧 EMAIL (опционально)
# ========================================

# Настройки SMTP для отправки email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ========================================
# 💳 ПЛАТЕЖИ (опционально)
# ========================================

# Настройки для платежной системы
PAYMENT_API_KEY=your-payment-api-key
PAYMENT_SECRET_KEY=your-payment-secret-key

# ========================================
# 📊 МОНИТОРИНГ (опционально)
# ========================================

# Sentry для мониторинга ошибок
SENTRY_DSN=your-sentry-dsn

# ========================================
# ПРИМЕЧАНИЯ:
# ========================================
# 1. Скопируйте этот файл в .env
# 2. Замените значения на реальные
# 3. НИКОГДА не коммитьте .env в Git!
# 4. Используйте токены вместо паролей
# 5. Регулярно обновляйте секреты

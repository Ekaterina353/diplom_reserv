[flake8]
max-line-length = 140
extend-ignore = E203, W503
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .env,
    migrations,
    staticfiles,
    media,
    node_modules,
    .pytest_cache,
    .mypy_cache,
    .coverage,
    htmlcov,
    dist,
    build,
    *.egg-info
per-file-ignores =
    __init__.py:F401
    migrations/*:E501
    tests/*:E501
    manage.py:E501